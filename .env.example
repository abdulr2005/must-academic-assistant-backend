GEMINI_API_KEY=your_gemini_api_key
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your_supabase_secret_or_service_role_key
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1024

# Text provider order: OpenRouter, Gemini, then optional Groq.
# Singular settings remain supported. Plural comma-separated settings, when
# provided, REPLACE the corresponding singular value and preserve list order.
OPENROUTER_TEXT_API_KEY=
OPENROUTER_TEXT_MODEL=minimax/minimax-m3:free
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_TEXT_API_KEYS=authorized_key_1,authorized_key_2
# OPENROUTER_TEXT_MODELS=first_model,second_model
# GEMINI_API_KEYS=authorized_key_1,authorized_key_2
# GEMINI_MODELS=first_model,second_model
# GROQ_API_KEYS=authorized_key_1,authorized_key_2
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Use only model IDs available to your account; no live model availability is assumed.
# Vision continues using OPENROUTER_API_KEY / OPENROUTER_MODEL separately.
